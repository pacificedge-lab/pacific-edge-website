---
import { getEntry, render } from 'astro:content';
import MarketingPage from '../layouts/MarketingPage.astro';
const entry=await getEntry('pages','education');
if(!entry)throw new Error('Missing education page content');
const {Content,headings}=await render(entry);
---
<MarketingPage page={entry.data} headings={headings} pageId="education"><Content /></MarketingPage>
