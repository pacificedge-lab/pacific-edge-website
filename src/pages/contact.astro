---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFields from '../components/ContactFields.astro';
import { contactAction } from '../lib/publication';
import '../styles/institution.css';
const endpoint = contactAction(import.meta.env.PUBLIC_CONTACT_ENDPOINT, import.meta.env.PUBLIC_CONTACT_ENABLED);
---
<BaseLayout title="Contact | Pacific Edge" description="Tell Pacific Edge what you're working on.">
  <div class="institution-page contact-page shell">
  <section class="contact-intro">
    <p class="eyebrow">Contact</p>
    <h1>What are you working on?</h1>
    <p class="lede">Tell us a little about what is happening. You do not need to have the problem neatly defined.</p>
    <p class="contact-location">Pacific Edge<br />Vancouver, British Columbia · Canada</p>
  </section>
  <section class="contact-surface" aria-label="Start a conversation">
      {endpoint ? (
        <form action={endpoint} method="post">
          <ContactFields />
          <button type="submit">Start the conversation →</button>
        </form>
      ) : (
        <div>
          <p class="contact-notice" id="contact-notice">Online enquiries will be available soon. This form is not accepting submissions yet.</p>
          <fieldset disabled aria-describedby="contact-notice"><legend>Start a conversation</legend><ContactFields /><button type="button" disabled>Start the conversation →</button></fieldset>
        </div>
      )}
  </section>
  </div>
</BaseLayout>
