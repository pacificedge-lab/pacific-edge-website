---
import WorkAttribution from '../components/WorkAttribution.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isReview, sortByOrder, visible, partnerVisible } from '../lib/content';
const work=sortByOrder((await getCollection('work')).filter(visible).filter(e=>e.data.featured)).slice(0,2);
const partners=sortByOrder((await getCollection('partners')).filter(partnerVisible).filter(e=>e.data.featured));
---
<BaseLayout title="Pacific Edge — Strategy, Operations and Leadership" description="Strategic advice, operational improvement and leadership support. Pacific Edge connects organizational priorities with technology and implementation.">

            <section class="pe-hero pe-shell" id="home-opening" aria-labelledby="home-title">
              <div class="pe-hero-image" data-image="coast" aria-hidden="true"></div>
              <div class="pe-hero-copy">
                <p class="pe-kicker">Strategy, operations and leadership</p>
                <h1 id="home-title">Clarity at the edge of complexity.</h1>
                <p class="pe-proposition">Pacific Edge helps leaders set direction, strengthen operations and lead change. We connect strategic decisions with the people, systems and technology needed to carry them through.</p>
                <div class="pe-actions"><a class="pe-button pe-button-light" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a><a class="pe-text-link" href="#home-services">Explore our services <span aria-hidden="true">↓</span></a></div>
                <p class="pe-founder-reference"><a href="#home-founder">Led by Chris McLean</a><span>Vancouver, Canada</span></p>
              </div>
            </section>
            <section class="pe-section pe-shell pe-services-section" id="home-services" aria-labelledby="home-services-title">
              <div class="pe-section-heading"><p class="pe-kicker">01 / Advisory</p><h2 id="home-services-title">Where we can help</h2></div>
              <div class="pe-service-list">
                <article><span class="pe-index">01</span><h3>Strategy and direction</h3><p>Resolve competing priorities, assess important choices and establish a direction your organization can act on.</p></article>
                <article><span class="pe-index">02</span><h3>Operations and capability</h3><p>Strengthen how work gets done, from responsibilities and workflows to information, digital systems and automation.</p></article>
                <article><span class="pe-index">03</span><h3>Advisory and leadership</h3><p>Bring experienced judgment and leadership into the work through ongoing strategic advice, fractional leadership or implementation support.</p></article>
              </div>
              <a class="pe-text-link pe-services-link" href="/advisory">How we can help <span aria-hidden="true">↗</span></a>
              <aside class="pe-recovery" aria-label="Initiative recovery"><h3>Has an important initiative stalled?</h3><div><p>Establish what is getting in the way and decide whether to recover the initiative, reshape it or change course. We can provide a focused assessment or leadership for the response.</p><a class="pe-text-link" href="/advisory#when-an-initiative-has-stalled">Discuss initiative recovery <span aria-hidden="true">↗</span></a></div></aside>
            </section>
            {(work.length > 0 || isReview) && <section class="pe-section pe-shell pe-work-section" id="home-work" aria-labelledby="home-work-title">
<div class="pe-section-heading"><p class="pe-kicker">02 / Experience</p><h2 id="home-work-title">Selected work</h2><p>Explore the situations, decisions and practical work behind selected assignments.</p></div>
{work.length ? <div class="pe-case-list">{work.map(entry=><article class="pe-case"><p class="pe-case-label">{entry.data.domains.join(' / ')}</p><h3><a href={`/work/${entry.id}`}>{entry.data.title}</a></h3><p class="pe-case-note">{entry.data.summary}</p><WorkAttribution organization={entry.data.organization} attribution={entry.data.attribution}/></article>)}</div> : <div class="pe-case-list"><article class="pe-case" data-case-placeholder><p class="pe-case-label">Case study to be supplied</p><h3>Strategic judgment and initiative recovery</h3><p class="pe-case-note">Space for a verified account of the situation, decisions and contribution.</p></article><article class="pe-case" data-case-placeholder><p class="pe-case-label">Case study to be supplied</p><h3>Operational and technology delivery</h3><p class="pe-case-note">Space for a verified account of the work and its supported results.</p></article></div>}
<a class="pe-text-link" href="/work">Explore selected work <span aria-hidden="true">↗</span></a></section>}

            <section class="pe-pathway pe-pathway-first" id="home-first-nations" aria-labelledby="home-first-nations-title">
              <div class="pe-path-image" data-image="cedar" aria-hidden="true"></div>
              <div class="pe-path-copy"><p class="pe-kicker">03 / Your priorities</p><h2 id="home-first-nations-title">First Nations and Indigenous organizations</h2><p>Build on your organization's knowledge and strengths to turn leadership priorities into practical plans and delivery. Support brings together strategy, organizational capacity, business and service design, and technology, shaped around your Nation or organization's requirements.</p><a class="pe-text-link" href="/first-nations">Explore First Nations and Indigenous services <span aria-hidden="true">↗</span></a></div>
            </section>
            <section class="pe-pathway pe-pathway-ai" id="home-ai" aria-labelledby="home-ai-title">
              <div class="pe-path-image" data-image="water" aria-hidden="true"></div>
              <div class="pe-path-copy"><p class="pe-kicker">04 / Technology</p><h2 id="home-ai-title">AI and automation</h2><p>Reduce repeated effort and give people more capacity for work that needs their judgment. We assess where AI or automation can improve the work, then establish the requirements for a reliable pilot or implementation.</p><a class="pe-text-link" href="/ai">Explore AI and automation <span aria-hidden="true">↗</span></a></div>
            </section>
            <section class="pe-section pe-shell pe-founder-section" id="home-founder" aria-labelledby="home-founder-title">
              <img class="pe-portrait" src="/images/chris.jpg" alt="Chris McLean" width="640" height="800" loading="lazy" decoding="async" />
              <div class="pe-founder-copy"><p class="pe-kicker">05 / Working with Pacific Edge</p><h2 id="home-founder-title">Led by Chris McLean</h2><p>Chris is a business consultant and former Director of Business Optimization with experience across operations, analytics, technology and organizational change.</p><p>His approach starts with understanding how the pieces fit: the decisions, workflows and information shaping the problem. Recommendations must work within the organization's actual resources and responsibilities.</p><a class="pe-text-link" href="/about">About Chris and Pacific Edge <span aria-hidden="true">↗</span></a><div class="pe-working"><h3>Working together</h3><p>Engage Pacific Edge for a focused assignment, implementation support or ongoing advice and fractional leadership. We agree the scope and responsibilities at the outset, with attention to the knowledge and capability your organization will retain.</p></div></div>
            </section>
{partners.length > 0 && <section class="pe-section pe-shell"><div class="pe-section-heading"><p class="pe-kicker">Working together</p><h2>Complementary expertise</h2></div><div class="pe-projects">{partners.map(partner=><article class="pe-project"><h3>{partner.data.name}</h3><p>{partner.data.summary}</p></article>)}</div><a class="pe-text-link" href="/partners">Meet our partners ↗</a></section>}
<section class="pe-section pe-shell pe-labs-section" id="home-labs" aria-labelledby="home-labs-title">
              <div><p class="pe-kicker">06 / Research and development</p><h2 id="home-labs-title">Pacific Edge Labs</h2></div>
              <div><p>Labs explores ideas and develops reusable capability, from research and experiments to practical tools and products. Selected work includes ISEF Support, a forthcoming tool for Indigenous education teams.</p><a class="pe-text-link" href="/labs">Explore Labs <span aria-hidden="true">↗</span></a></div>
            </section>
            <section class="pe-section pe-shell pe-closing" id="home-contact" aria-labelledby="home-contact-title"><p class="pe-kicker">Start a conversation</p><h2 id="home-contact-title">What are you working on?</h2><div class="pe-closing-bottom"><p>Start a conversation with Chris about the decision, challenge or initiative in front of you. A short description is enough to begin.</p><a class="pe-button pe-button-light" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a></div></section>

</BaseLayout>
