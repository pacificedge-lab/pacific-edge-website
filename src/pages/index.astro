---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { sortByOrder, titleFromKind, visible } from '../lib/content';

const work = sortByOrder((await getCollection('work')).filter(visible).filter((e) => e.data.featured)).slice(0, 3);
const labs = sortByOrder((await getCollection('labs')).filter(visible).filter((e) => e.data.featured)).slice(0, 3);
const ideas = sortByOrder((await getCollection('ideas')).filter(visible).filter((e) => e.data.featured)).slice(0, 3);
const partners = sortByOrder((await getCollection('partners')).filter(visible).filter((e) => e.data.publish && e.data.featured));

const capabilities = [
  ['Strategy & Decision Support', 'Make difficult situations intelligible and establish coherent choices.'],
  ['Operating Systems & Transformation', 'Turn decisions into processes, structures and operating capability.'],
  ['Technology & AI', 'Use technology where it improves the system rather than simply adding another layer.'],
  ['Organizational Capability', 'Create the knowledge, tools and practices required for sustained execution.'],
];
---

<BaseLayout>
  <section class="hero hero--dark">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Understand · Design · Build</p>
        <h1>Clarity at the edge of complexity.</h1>
        <p>Pacific Edge helps organizations understand difficult problems, make better decisions, and build the systems required to act on them.</p>
        <div class="hero-links">
          <a class="text-link text-link--inverse" href="/contact">What are you working on? →</a>
          <a class="text-link text-link--muted" href="/work">Explore our work →</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="horizon"></div>
        <div class="topography"></div>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="shell">
      <SectionHeading title="We work from understanding to action." intro="Difficult problems rarely arrive neatly labelled. We move across strategy, operations, technology and implementation to find what actually matters." />
      <div class="three-step">
        <article><span class="index">01</span><h3>Understand</h3><p>See the bigger picture. Clarify what matters.</p></article>
        <article><span class="index">02</span><h3>Design</h3><p>Create practical pathways for change.</p></article>
        <article><span class="index">03</span><h3>Build</h3><p>Turn insight into real-world capability.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--work">
    <div class="shell">
      <SectionHeading eyebrow="Selected Work" title="A few things worth showing." />
      <div class="feature-grid">
        {work.map((entry, i) => <EntryCard tone="dark" eyebrow={entry.data.domains.join(' · ')} title={entry.data.title} summary={entry.data.summary} href={`/work/${entry.id}`} meta={i === 0 ? 'Featured' : undefined} />)}
      </div>
      <a class="text-link text-link--inverse section-link" href="/work">Explore more work →</a>
    </div>
  </section>

  <section class="section section--light">
    <div class="shell">
      <SectionHeading title="Complex problems rarely fit inside a single discipline." intro="The problem should define the approach—not the org chart." />
      <div class="capability-list">
        {capabilities.map(([title, summary], index) => (
          <article><span class="index">0{index + 1}</span><div><h3>{title}</h3><p>{summary}</p></div></article>
        ))}
      </div>
      <a class="text-link section-link" href="/capabilities">Explore our capabilities →</a>
    </div>
  </section>

  <section class="section section--labs">
    <div class="shell">
      <SectionHeading eyebrow="Pacific Edge Labs" title="We build things when the problem calls for something that doesn't exist yet." intro="Applied systems, operational tools and prototypes developed from real problems." />
      <div class="listing-grid listing-grid--dark">
        {labs.map((entry) => <EntryCard tone="dark" eyebrow={`${entry.data.projectType.replace('-', ' ')} · ${entry.data.developmentStatus}`} title={entry.data.title} summary={entry.data.summary} href={`/labs/${entry.id}`} />)}
      </div>
      <a class="text-link text-link--inverse section-link" href="/labs">Explore Labs →</a>
    </div>
  </section>

  <section class="section section--ideas">
    <div class="shell">
      <SectionHeading eyebrow="Ideas" title="Ideas worth preserving." intro="Field notes, frameworks and research on the systems shaping how organizations work." />
      <div class="listing-grid">
        {ideas.map((entry) => <EntryCard eyebrow={titleFromKind(entry.data.kind)} title={entry.data.title} summary={entry.data.summary} href={`/ideas/${entry.id}`} />)}
      </div>
      <a class="text-link section-link" href="/ideas">Explore Ideas →</a>
    </div>
  </section>

  {partners.length > 0 && (
    <section class="section section--partners">
      <div class="shell">
        <SectionHeading eyebrow="Partners" title="Better work is often collaborative." intro="Pacific Edge works with a carefully selected network of partners where complementary expertise improves the outcome." />
        <div class="partner-list">
          {partners.map((partner) => <article><h3>{partner.data.name}</h3><p>{partner.data.summary}</p></article>)}
        </div>
      </div>
    </section>
  )}

  <section class="institutional-pause">
    <div class="shell narrow">
      <p class="eyebrow">Pacific Edge</p>
      <p class="display-statement">We work across disciplines because difficult problems rarely respect organizational boundaries.</p>
      <a class="text-link" href="/about">How we work →</a>
    </div>
  </section>

  <section class="closing-cta">
    <div class="shell narrow">
      <h2>What are you working on?</h2>
      <p>If you're dealing with something complicated, consequential, or difficult to fit neatly into a box, we'd be interested to hear about it.</p>
      <a class="text-link text-link--inverse" href="/contact">Start a conversation →</a>
    </div>
  </section>
</BaseLayout>
