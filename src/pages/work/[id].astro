---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { sortByOrder, visible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).filter(visible);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = sortByOrder((await getCollection('work')).filter(visible).filter((item) => item.id !== entry.id)).slice(0, 2).map((item) => ({ title: item.data.title, href: `/work/${item.id}`, label: item.data.domains.join(' / ') || 'Work' }));
const facts = [
  { label: 'Disciplines', values: entry.data.domains },
  { label: 'Capabilities', values: entry.data.capabilities },
];
---
<ContentLayout kind="work" title={entry.data.title} description={entry.data.summary} eyebrow="Selected Work" facts={facts} related={related} headings={headings}>
  <Content />
</ContentLayout>
