---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import CollectionEmpty from '../../components/CollectionEmpty.astro';
import { sortByOrder, titleFromKind, visible } from '../../lib/content';
const entries = sortByOrder((await getCollection('ideas')).filter(visible));
---
<BaseLayout title="Ideas | Pacific Edge" description="Field notes, frameworks and research from Pacific Edge.">
  <section class="page-intro shell"><p class="eyebrow">Ideas</p><h1>Ideas worth preserving.</h1><p class="lede">Field notes, frameworks and research on the systems shaping how organizations work.</p></section>
  <section class="section section--light"><div class="shell listing-grid">
    {entries.length === 0 && <CollectionEmpty kind="ideas" />}
    {entries.map((entry) => <EntryCard eyebrow={titleFromKind(entry.data.kind)} title={entry.data.title} summary={entry.data.summary} href={`/ideas/${entry.id}`} />)}
  </div></section>
</BaseLayout>
