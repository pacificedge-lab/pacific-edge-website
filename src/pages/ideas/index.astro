---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import {sortByOrder,titleFromKind,visible} from '../../lib/content';
const entries=sortByOrder((await getCollection('ideas')).filter(visible));
---
<BaseLayout title="Ideas — Pacific Edge" description="Field notes, frameworks and research from Pacific Edge." noindex={!entries.length}>
<PageHero title="Ideas worth preserving." lead="Field notes, frameworks and research on the systems shaping how organizations work." eyebrow="Ideas" image="water"/>
<section class="pe-section pe-shell"><div class="pe-projects">{entries.map(entry=><article class="pe-project"><p class="pe-kicker">{titleFromKind(entry.data.kind)}{entry.data.status!=='published'?' / Draft':''}</p><h3><a href={`/ideas/${entry.id}`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p><a class="pe-text-link" href={`/ideas/${entry.id}`}>Read the note ↗</a></article>)}</div>{!entries.length&&<p>Public notes will appear here as they are ready.</p>}</section></BaseLayout>
