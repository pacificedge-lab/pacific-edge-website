---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { titleFromKind, visible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('ideas')).filter(visible);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ContentLayout title={entry.data.title} description={entry.data.summary} eyebrow={titleFromKind(entry.data.kind)}>
  <Content />
</ContentLayout>
