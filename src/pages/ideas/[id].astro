---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { sortByOrder, titleFromKind, visible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('ideas')).filter(visible);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = sortByOrder((await getCollection('ideas')).filter(visible).filter((item) => item.id !== entry.id)).slice(0, 2).map((item) => ({ title: item.data.title, href: `/ideas/${item.id}`, label: titleFromKind(item.data.kind) }));
const facts = [
  { label: 'Format', values: [titleFromKind(entry.data.kind)] },
  ...(entry.data.publishedAt ? [{ label: 'Published', values: [new Intl.DateTimeFormat('en-CA', { dateStyle: 'long', timeZone: 'UTC' }).format(entry.data.publishedAt)] }] : []),
];
---
<ContentLayout kind="ideas" title={entry.data.title} description={entry.data.summary} eyebrow={titleFromKind(entry.data.kind)} facts={facts} related={related} headings={headings}>
  <Content />
</ContentLayout>
