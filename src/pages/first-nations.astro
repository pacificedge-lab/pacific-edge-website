---
import { getEntry, render } from 'astro:content';
import MarketingPage from '../layouts/MarketingPage.astro';
const entry=await getEntry('pages','first-nations');
if(!entry)throw new Error('Missing first-nations page content');
const {Content,headings}=await render(entry);
---
<MarketingPage page={entry.data} headings={headings} pageId="first-nations"><Content /></MarketingPage>
