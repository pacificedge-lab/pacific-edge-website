---
import { getEntry, render } from 'astro:content';
import MarketingPage from '../layouts/MarketingPage.astro';
const entry=await getEntry('pages','partners');
if(!entry)throw new Error('Missing partners page content');
const {Content,headings}=await render(entry);
---
<MarketingPage page={entry.data} headings={headings} pageId="partners"><Content /></MarketingPage>
