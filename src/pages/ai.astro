---
import { getEntry, render } from 'astro:content';
import MarketingPage from '../layouts/MarketingPage.astro';
const entry=await getEntry('pages','ai');
if(!entry)throw new Error('Missing ai page content');
const {Content,headings}=await render(entry);
---
<MarketingPage page={entry.data} headings={headings} pageId="ai"><Content /></MarketingPage>
