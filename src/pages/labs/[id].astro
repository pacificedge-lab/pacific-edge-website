---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { sortByOrder, visible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('labs')).filter(visible);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = sortByOrder((await getCollection('labs')).filter(visible).filter((item) => item.id !== entry.id)).slice(0, 2).map((item) => ({ title: item.data.title, href: `/labs/${item.id}`, label: item.data.projectType.replaceAll('-', ' ') }));
const facts = [
  { label: 'Project type', values: [entry.data.projectType.replaceAll('-', ' ')] },
  { label: 'Development status', values: [entry.data.developmentStatus] },
];
---
<ContentLayout kind="labs" title={entry.data.title} description={entry.data.summary} eyebrow="Pacific Edge Labs" facts={facts} related={related} headings={headings}>
  <Content />
</ContentLayout>
