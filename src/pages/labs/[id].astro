---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { visible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('labs')).filter(visible);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ContentLayout title={entry.data.title} description={entry.data.summary} eyebrow="Pacific Edge Labs" meta={`${entry.data.projectType.replace('-', ' ')} · ${entry.data.developmentStatus}`}>
  <Content />
</ContentLayout>
