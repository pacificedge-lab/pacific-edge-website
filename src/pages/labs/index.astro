---
import { getEntry, render } from 'astro:content';
import MarketingPage from '../../layouts/MarketingPage.astro';
const entry=await getEntry('pages','labs');
if(!entry)throw new Error('Missing labs page content');
const {Content,headings}=await render(entry);
---
<MarketingPage page={entry.data} headings={headings} pageId="labs"><Content /></MarketingPage>
