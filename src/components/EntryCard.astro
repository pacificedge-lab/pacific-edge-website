---
interface Props {
  eyebrow?: string;
  title: string;
  summary: string;
  href: string;
  meta?: string;
  tone?: 'light' | 'dark';
}

const { eyebrow, title, summary, href, meta, tone = 'light' } = Astro.props;
---

<article class:list={['entry-card', `entry-card--${tone}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  {meta && <p class="entry-meta">{meta}</p>}
  <a class="text-link" href={href}>Explore →</a>
</article>
