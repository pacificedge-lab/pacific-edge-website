---
interface Props {
  organization?: string;
  attribution?: string;
}
const { organization, attribution } = Astro.props;
const context = organization ? organization.charAt(0).toLowerCase() + organization.slice(1) : undefined;
const caption = attribution && context
  ? `From ${attribution} with a ${context}.`
  : attribution || organization;
---
{caption && <p class="pe-work-attribution">{caption}</p>}
