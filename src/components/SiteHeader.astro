---
const pathname = Astro.url.pathname;
const links = [
  ['Work', '/work'],
  ['Capabilities', '/capabilities'],
  ['Labs', '/labs'],
  ['Ideas', '/ideas'],
  ['About', '/about'],
];
---

<header class:list={['site-header', { 'site-header--light': pathname !== '/' }]}>
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Pacific Edge home">PACIFIC EDGE</a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([label, href]) => (
        <a class:list={{ active: pathname.startsWith(href) }} aria-current={pathname.startsWith(href) ? 'page' : undefined} href={href}>{label}</a>
      ))}
      <a class="contact-link" href="/contact">Contact</a>
    </nav>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {links.map(([label, href]) => <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        <a href="/contact">Start a conversation →</a>
      </nav>
    </details>
  </div>
</header>
