---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  darkHeader?: boolean;
  article?: boolean;
}

const {
  title = 'Pacific Edge | Clarity at the edge of complexity',
  description = 'Pacific Edge helps organizations understand difficult problems, make better decisions, and build the systems required to act on them.',
  darkHeader = false,
  article = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader dark={darkHeader} />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
