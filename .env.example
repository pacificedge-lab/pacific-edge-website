# Explicit review builds include editorial placeholders and noindex metadata.
SITE_REVIEW=false
# Dedicated protected form acceptance builds set this explicitly; ordinary reviews force it false.
SITE_CONTACT_TEST=false
# Mailbox and preview delivery/Reply-To accepted by Chris on 22 October.
# npm run build enables the production form; build:review always disables submission.
PUBLIC_CONTACT_EMAIL=hello@thepacificedge.ca
PUBLIC_CONTACT_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFhZOFMZaIq7bLvM
# Disable framework telemetry during local builds.
ASTRO_TELEMETRY_DISABLED=1
